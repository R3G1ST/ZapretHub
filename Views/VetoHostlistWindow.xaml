<Window x:Class="ZapretHub.Views.VetoHostlistWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Veto - Hostlist Manager"
        Height="620" Width="820"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <PathGeometry x:Key="ListIcon">M4,6 L8,6 M4,10 L8,10 M4,14 L8,14 M12,6 L20,6 M12,10 L20,10 M12,14 L20,14 M4,18 L8,18 M12,18 L20,18</PathGeometry>
        <PathGeometry x:Key="CloseIcon">M6,6 L18,18 M18,6 L6,18</PathGeometry>
        <PathGeometry x:Key="PlusIcon">M12,2 L12,22 M2,12 L22,12</PathGeometry>
        <PathGeometry x:Key="ImportIcon">M12,4 L12,16 M6,10 L12,16 L18,10 M6,20 L18,20</PathGeometry>
        <PathGeometry x:Key="DeleteIcon">M5,7 L19,7 M9,7 L9,5 L15,5 L15,7 M8,7 L8,20 L16,20 L16,7 M10,11 L10,16 M14,11 L14,16</PathGeometry>
        <PathGeometry x:Key="CheckIcon">M5,12 L10,17 L19,7</PathGeometry>

        <Style x:Key="FlatBtn" TargetType="Button">
            <Setter Property="Background"   Value="Transparent"/>
            <Setter Property="BorderBrush"  Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground"   Value="#5a6a7a"/>
            <Setter Property="FontFamily"   Value="Cascadia Code, Consolas, monospace"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Padding"      Value="12,6"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlatBtnCentered" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent"
                                CornerRadius="8"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#08080e"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#ef4444"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#b91c1c"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="Background"   Value="#00ff88"/>
            <Setter Property="Foreground"   Value="#030306"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily"   Value="Cascadia Code, Consolas, monospace"/>
            <Setter Property="FontSize"     Value="13"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Setter Property="Padding"      Value="20,8"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect Color="#00ff88" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#00cc6a"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="OutlineBtn" TargetType="Button" BasedOn="{StaticResource FlatBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent"
                                BorderBrush="#181820" BorderThickness="1"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#08080e"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Width" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="#181820" CornerRadius="4" Width="4" HorizontalAlignment="Right" Margin="0,4,12,4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a0a0b0"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#08080e"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0d1a14"/>
                                <Setter Property="Foreground" Value="#00ff88"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#030306" CornerRadius="14" BorderBrush="#0a0a12" BorderThickness="1" ClipToBounds="True">
        <Grid x:Name="RootGrid" Margin="1,1,-1,-1">
        <Rectangle IsHitTestVisible="False" Opacity="0.04"
                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                   RenderOptions.EdgeMode="Aliased">
            <Rectangle.Fill>
                <ImageBrush ImageSource="pack://application:,,,/Assets/noise.png"
                            TileMode="Tile" ViewportUnits="Absolute"
                            Viewport="0,0,512,512" Stretch="None"/>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="1,1,-1,-1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" MinHeight="71"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto" MinHeight="57"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="28,14,28,10"
                  MouseLeftButtonDown="Header_MouseLeftButtonDown"
                  Cursor="SizeAll">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="8" Background="#08080e" BorderBrush="#181820" BorderThickness="1" Margin="0,0,12,0">
                        <Path Width="16" Height="16" Stretch="Uniform"
                              VerticalAlignment="Center" HorizontalAlignment="Center"
                              Data="{StaticResource ListIcon}"
                              Stroke="#00ff88" StrokeThickness="1.4"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Veto Engine" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" Foreground="#5a6a7a" FontWeight="Medium"/>
                        <TextBlock Text="Hostlist Manager" FontFamily="Cascadia Code, Consolas, monospace" FontSize="15" FontWeight="SemiBold" Foreground="#f0f0f0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderInfo" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11"
                               Foreground="#5a6a7a" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <Button Style="{StaticResource FlatBtnCentered}"
                            Width="34" Height="18.62" MinWidth="34" MinHeight="18.62" Padding="0,0,0,1" FontSize="14"
                            Click="MinBtn_Click">
                        <TextBlock Text="&#x2212;" Margin="0,-1,0,0"/>
                    </Button>
                    <Button Style="{StaticResource CloseBtn}"
                            Width="34" Height="18.62" Padding="0" Margin="-6,0,0,0"
                            Click="CloseBtn_Click">
                        <Path Data="{StaticResource CloseIcon}"
                              Stroke="#5a6a7a"
                              StrokeThickness="2"
                              Width="12" Height="12"
                              Stretch="Uniform"/>
                    </Button>
                </StackPanel>
            </Grid>
            <Border Grid.Row="0" Height="1" Background="#0a0a12" Margin="28,68,28,0" VerticalAlignment="Top"/>

            <Grid Grid.Row="1" Margin="28,16,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="230"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: hostlist files -->
                <DockPanel Grid.Column="0" Margin="0,0,14,0">
                    <TextBlock DockPanel.Dock="Top" Text="СПИСОК ФАЙЛОВ" FontFamily="Cascadia Code, Consolas, monospace"
                               FontSize="10" Foreground="#5a6a7a" FontWeight="Bold" Margin="2,0,0,6"/>
                    <Grid DockPanel.Dock="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Style="{StaticResource OutlineBtn}" Padding="8,6" Margin="0,8,4,0"
                                Click="NewBtn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource PlusIcon}" Stroke="#00ff88" StrokeThickness="1.4" Width="12" Height="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Создать" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" Foreground="#a0a0b0"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource OutlineBtn}" Padding="8,6" Margin="4,8,0,0"
                                Click="ImportBtn_Click">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Path Data="{StaticResource ImportIcon}" Stroke="#00ff88" StrokeThickness="1.4" Width="12" Height="12" Margin="0,0,6,0"/>
                                <TextBlock Text="Импорт" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" Foreground="#a0a0b0"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <ListBox x:Name="FilesList" BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ItemContainerStyle="{StaticResource ListBoxItemStyle}"
                             SelectionChanged="FilesList_SelectionChanged"/>
                </DockPanel>

                <Border Grid.Column="1" Background="#0a0a12" Margin="0,2,0,2"/>

                <!-- Right: editor -->
                <Grid Grid.Column="2" Margin="14,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="CurrentFileName" FontFamily="Cascadia Code, Consolas, monospace"
                                       FontSize="14" FontWeight="SemiBold" Foreground="#f0f0f0" VerticalAlignment="Center"/>
                            <Border x:Name="ActiveBadge" Visibility="Collapsed" Background="#00ff88" CornerRadius="6"
                                    Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="АКТИВЕН" FontFamily="Cascadia Code, Consolas, monospace" FontSize="9"
                                           FontWeight="Bold" Foreground="#030306"/>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="DomainCountLbl" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11"
                                       Foreground="#5a6a7a" Margin="0,0,12,0" VerticalAlignment="Center"/>
                            <Button x:Name="DeleteBtn" Style="{StaticResource OutlineBtn}" Padding="8,6"
                                    Margin="0,0,8,0" Click="DeleteBtn_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource DeleteIcon}" Stroke="#ef4444" StrokeThickness="1.4" Width="12" Height="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Удалить" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" Foreground="#ef4444"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="SetActiveBtn" Style="{StaticResource OutlineBtn}" Padding="10,6" Margin="0,0,8,0"
                                    Click="SetActiveBtn_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource CheckIcon}" Stroke="#00ff88" StrokeThickness="1.6" Width="12" Height="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Сделать активным" FontFamily="Cascadia Code, Consolas, monospace" FontSize="11" Foreground="#a0a0b0"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBox x:Name="Editor" Grid.Row="1"
                             Background="#08080e" Foreground="#e0e0e0"
                             BorderBrush="#181820" BorderThickness="1"
                             FontFamily="Cascadia Code, Consolas, monospace"
                             FontSize="13"
                             Padding="14,12"
                             AcceptsReturn="True" AcceptsTab="True"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap"
                             TextChanged="Editor_TextChanged"
                             IsEnabled="False"/>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#060609" CornerRadius="0,0,14,14"
                    BorderBrush="#0a0a12" BorderThickness="0,1,0,0"
                    Margin="0,16,0,0" Padding="28,10,28,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="StatusLbl"
                               FontFamily="Cascadia Code, Consolas, monospace" FontSize="11"
                               Foreground="#5a6a7a" TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Готово"
                            MinWidth="120" MinHeight="36"
                            Style="{StaticResource AccentBtn}"
                            Click="CloseBtn_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Border>
</Window>
